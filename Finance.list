# =================================================================
# Finance.list - Quantumult X 国际数字银行、欧洲电子钱包、外汇券商与加密货币分流规则
# 与 Finance.yaml 保持 1:1 完全同步 | 归属策略组: Banking (瑞士/欧洲节点)
# =================================================================

# ---------------- 1. 瑞士及欧洲数字银行 / 金融账户 ----------------
# Dukascopy (瑞士杜高斯贝银行)
HOST-SUFFIX,dukascopy.com,Banking
HOST-SUFFIX,dukascopy.bank,Banking
# Swissquote & Yuh (瑞士瑞讯银行 & Yuh)
HOST-SUFFIX,yuh-api.swissquote.ch,Banking
HOST-SUFFIX,yuh.swissquote.ch,Banking
HOST-SUFFIX,swissquote.ch,Banking
HOST-SUFFIX,swissquote.info,Banking
# FlowBank
HOST-SUFFIX,flowbank.com,Banking
# N26 (德国数字银行 - 强风控：严禁中国大陆 IP 直连，必须使用固定瑞士/欧洲节点)
HOST-SUFFIX,n26.com,Banking
HOST-SUFFIX,tech26.de,Banking
HOST-SUFFIX,number26.de,Banking
# iFast Global Bank (英国奕丰环球银行 - 固定欧洲/瑞士节点维持漫游定位)
HOST-SUFFIX,ifastgb.com,Banking
# Wise (原 TransferWise) & 两步验证
HOST-SUFFIX,wise.com,Banking
HOST-SUFFIX,transferwise.com,Banking
HOST-SUFFIX,authy.com,Banking
# Paysera / Monese / Vivid / Curve / Revolut
HOST-SUFFIX,paysera.com,Banking
HOST-SUFFIX,monese.com,Banking
HOST-SUFFIX,fra-01.braze.eu,Banking
HOST-SUFFIX,vivid.money,Banking
HOST-SUFFIX,curve.com,Banking
HOST-SUFFIX,revolut.com,Banking
# Skrill / Sticpay / Neteller (Paysafe 集团欧洲电子钱包 - 固定欧洲纯净 IP)
HOST-SUFFIX,skrill.com,Banking
HOST-SUFFIX,sticpay.com,Banking
HOST-SUFFIX,neteller.com,Banking
HOST-SUFFIX,paysafe.com,Banking
# IG Group & 国际经纪商
HOST-SUFFIX,ig.com,Banking

